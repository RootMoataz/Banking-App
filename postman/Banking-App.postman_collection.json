    {
      "name": "Deposit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": \"100.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "After a replayed Idempotency-Key whose account has since been deleted, the response is the stored Transaction (it has balanceAfter, not balance). Here the account still exists, so the replay returns the Account."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"idempotencyKey\", \"deposit-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Balance 100.00\", () => pm.expect(pm.response.json().balance).to.eql(\"100.00\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Retry Deposit (same Idempotency-Key)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": \"100.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "After a replayed Idempotency-Key whose account has since been deleted, the response is the stored Transaction (it has balanceAfter, not balance). Here the account still exists, so the replay returns the Account."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Replay returns the first result\", () => pm.expect(pm.response.json().balance).to.eql(\"100.00\"));"
            ]
          }
        }
      ]
    },
