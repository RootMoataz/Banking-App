        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Moataz Hikal\",\n  \"email\": \"updated.{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Customer name\", () => pm.expect(pm.response.json().name).to.eql(\"Moataz Hikal\"));",
              "pm.test(\"Email updated\", () => pm.expect(pm.response.json().email).to.eql(\"updated.\" + pm.collectionVariables.get(\"email\")));"
            ]
          }
        }
      ]
    },
