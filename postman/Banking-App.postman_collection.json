{
  "info": {
    "name": "Paper Maker Banking App - Customer and Account CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "secondAccountId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "auditCursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/customers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Moataz Hikal\",\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"email\", \"moataz.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"customerId\", pm.response.json().customerId);"
            ]
          }
        }
      ]
    },
    {
      "name": "GetAllCustomers",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "GetCustomerById",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers/{{customerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Edit Customer",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/customers/{{customerId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Moataz Hikal\",\n  \"email\": \"updated.{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Customer name\", () => pm.expect(pm.response.json().name).to.eql(\"Moataz Hikal\"));",
              "pm.test(\"Email updated\", () => pm.expect(pm.response.json().email).to.eql(\"updated.\" + pm.collectionVariables.get(\"email\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"SAVINGS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"accountId\", pm.response.json().accountId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Second Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountType\": \"CURRENT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"secondAccountId\", pm.response.json().accountId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Customer Accounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers/{{customerId}}/accounts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"One customer owns two accounts\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "GetAllAccounts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/accounts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Edit Account",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountType\": \"CURRENT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Type updated\", () => pm.expect(pm.response.json().accountType).to.eql(\"CURRENT\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deposit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": \"100.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"idempotencyKey\", \"deposit-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Balance 100.00\", () => pm.expect(pm.response.json().balance).to.eql(\"100.00\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Retry Deposit (same Idempotency-Key)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/deposit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": \"100.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Replay returns the first result\", () => pm.expect(pm.response.json().balance).to.eql(\"100.00\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Withdraw",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/withdraw",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": \"25.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Balance 75.00\", () => pm.expect(pm.response.json().balance).to.eql(\"75.00\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Account",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Balance 75.00\", () => pm.expect(pm.response.json().balance).to.eql(\"75.00\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/transactions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Two transactions\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers/search?email=updated.{{email}}&category=LOW"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"One LOW customer with 75.00\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r).to.have.lengthOf(1);",
              "  pm.expect(r[0].customerId).to.eql(pm.collectionVariables.get(\"customerId\"));",
              "  pm.expect(r[0].totalBalance).to.eql(\"75.00\");",
              "  pm.expect(r[0].category).to.eql(\"LOW\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Alerts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/alerts?customerId={{customerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"One LOW_BALANCE alert\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r).to.have.lengthOf(1);",
              "  pm.expect(r[0].type).to.eql(\"LOW_BALANCE\");",
              "  pm.expect(r[0].totalBalance).to.eql(\"75.00\");",
              "  pm.expect(r[0].threshold).to.eql(\"100.00\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Audit First Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/audit/transactions?customerId={{customerId}}&from=2020-01-01T00:00:00Z&limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"First page holds the deposit\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.items.map(t => t.type)).to.eql([\"DEPOSIT\"]);",
              "  pm.expect(r.nextCursor).to.be.a(\"string\");",
              "});",
              "pm.collectionVariables.set(\"auditCursor\", pm.response.json().nextCursor);"
            ]
          }
        }
      ]
    },
    {
      "name": "Audit Next Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/audit/transactions?customerId={{customerId}}&from=2020-01-01T00:00:00Z&limit=1&cursor={{auditCursor}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Last page holds the withdrawal\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.items.map(t => t.type)).to.eql([\"WITHDRAW\"]);",
              "  pm.expect(r.nextCursor).to.eql(null);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Overdraft rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/withdraw",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": \"76.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Nonzero account deletion rejected",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer with accounts deletion rejected",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/customers/{{customerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Drain Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/withdraw",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": \"75.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Zero balance\", () => pm.expect(pm.response.json().balance).to.eql(\"0.00\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Account",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Empty response\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Second Account",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/accounts/{{secondAccountId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Empty response\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Customer",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/customers/{{customerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Empty response\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted Customer not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers/{{customerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Audit After Deletion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/audit/transactions?customerId={{customerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"History survives deletion\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.items.map(t => t.type)).to.eql([\"DEPOSIT\", \"WITHDRAW\", \"WITHDRAW\"]);",
              "  pm.expect(new Set(r.items.map(t => t.accountId))).to.eql(new Set([pm.collectionVariables.get(\"accountId\")]));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
