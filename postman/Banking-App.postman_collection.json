      ]
    },
    {
      "name": "Transactions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/transactions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Two transactions\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));"
            ]
          }
        }
      ]
