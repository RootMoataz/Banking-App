    {
      "name": "Search Customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers/search?email={{emailQuery}}&category=LOW"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailQuery\", encodeURIComponent(\"updated.\" + pm.collectionVariables.get(\"email\")));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"One LOW customer with 75.00\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r).to.have.lengthOf(1);",
              "  pm.expect(r[0].customerId).to.eql(pm.collectionVariables.get(\"customerId\"));",
              "  pm.expect(r[0].totalBalance).to.eql(\"75.00\");",
              "  pm.expect(r[0].category).to.eql(\"LOW\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Notifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customers/{{customerId}}/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Low-balance alert and opted-in loan marketing\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r).to.have.lengthOf(2);",
              "  pm.expect(r.map(n => n.kind).sort()).to.eql([\"LOW_BALANCE_ALERT\", \"LOW_BALANCE_MARKETING\"]);",
              "  r.forEach(n => pm.expect([n.category, n.categoryVersion]).to.eql([\"LOW\", 2]));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Audit First Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/audit/transactions?customerId={{customerId}}&from=2020-01-01T00:00:00Z&limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"First page holds the deposit\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.items.map(t => t.type)).to.eql([\"DEPOSIT\"]);",
              "  pm.expect(r.nextCursor).to.be.a(\"string\");",
              "});",
              "pm.collectionVariables.set(\"auditCursor\", pm.response.json().nextCursor);"
            ]
          }
        }
      ]
    },
    {
      "name": "Audit Next Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/audit/transactions?customerId={{customerId}}&from=2020-01-01T00:00:00Z&limit=1&cursor={{auditCursor}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Last page holds the withdrawal\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.items.map(t => t.type)).to.eql([\"WITHDRAW\"]);",
              "  pm.expect(r.nextCursor).to.eql(null);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Transfer Between Accounts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{transferKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/transfers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"{{secondAccountId}}\",\n  \"amount\": \"25.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Moves 25.00 from the first account to the second. Both belong to one customer, so the customer's total stays 75.00 and no notification is stored. Transfers work between any two accounts, including other customers' accounts."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"transferKey\", \"transfer-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Both balances\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect([r.fromBalanceAfter, r.toBalanceAfter]).to.eql([\"50.00\", \"25.00\"]);",
              "  pm.expect([r.fromAccountId, r.toAccountId]).to.eql([pm.collectionVariables.get(\"accountId\"), pm.collectionVariables.get(\"secondAccountId\")]);",
              "});",
              "pm.collectionVariables.set(\"transferId\", pm.response.json().transferId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Retry Transfer (same Idempotency-Key)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{transferKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/transfers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"{{secondAccountId}}\",\n  \"amount\": \"25.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Replays the first transfer\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.transferId).to.eql(pm.collectionVariables.get(\"transferId\"));",
              "  pm.expect([r.fromBalanceAfter, r.toBalanceAfter]).to.eql([\"50.00\", \"25.00\"]);",
              "});"
            ]
          }
        }
      ]
    },
