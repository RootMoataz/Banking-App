{
  "info": {
    "name": "Paper Maker Banking App - Customer and Account CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "adminEmail",
      "value": "set-me"
    },
    {
      "key": "adminPassword",
      "value": "set-me"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "customerPassword",
      "value": ""
    },
    {
      "key": "customerSelfId",
      "value": ""
    },
    {
      "key": "customerAccountId",
      "value": ""
    },
    {
      "key": "customerSecondAccountId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "secondAccountId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "auditCursor",
      "value": ""
    },
    {
      "key": "emailQuery",
      "value": ""
    },
    {
      "key": "transferKey",
      "value": ""
    },
    {
      "key": "transferId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/public/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Casey Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates a customer and a CUSTOMER login. The token is stored as customerToken (and as token until the admin login right after replaces it)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"customerEmail\", \"casey.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");",
                  "pm.collectionVariables.set(\"customerPassword\", \"pw-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Role CUSTOMER\", () => pm.expect(body.user.role).to.eql(\"CUSTOMER\"));",
                  "pm.collectionVariables.set(\"token\", body.token);",
                  "pm.collectionVariables.set(\"customerToken\", body.token);",
                  "pm.collectionVariables.set(\"customerSelfId\", body.user.customerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Logs in as the admin from adminEmail and adminPassword and stores the token. Run this before the admin requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Role ADMIN\", () => pm.expect(body.user.role).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"token\", body.token);",
                  "pm.collectionVariables.set(\"adminToken\", body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Signed in as admin\", () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"adminEmail\")));"
                ]
              }
            }
          ]
        }
      ]
    },
