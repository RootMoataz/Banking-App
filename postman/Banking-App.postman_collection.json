              "  pm.expect(r.items.map(t => t.accountId).filter((id, i, all) => all.indexOf(id) === i).sort()).to.eql([pm.collectionVariables.get(\"accountId\"), pm.collectionVariables.get(\"secondAccountId\")].sort());",
