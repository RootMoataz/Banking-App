          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"At or above the threshold, highest first\", () => {",
              "  const balances = pm.response.json().map(a => Number(a.balance));",
              "  pm.expect(balances.every(b => b >= 25)).to.be.true;",
              "  pm.expect(balances).to.eql([...balances].sort((x, y) => y - x));",
              "});"
