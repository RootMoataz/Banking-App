          "mode": "raw",
          "raw": "{\n  \"marketingEnabled\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Marketing enabled\", () => pm.expect(pm.response.json().marketingEnabled).to.eql(true));"
            ]
          }
        }
      ]
    },
