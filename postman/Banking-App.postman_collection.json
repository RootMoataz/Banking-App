            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Balance 75.00\", () => pm.expect(pm.response.json().balance).to.eql(\"75.00\"));"
            ]
